{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign logo_alt = 'header.logo_alt' | t: brand: brand
-%}

<header class="header">
  <div class="header__bar">
    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 320 | image_tag: widths: '160, 240, 320', sizes: '(min-width: 640px) 160px, 128px', alt: logo_alt, class: 'header__logo-image' }}
      {%- else -%}
        <img class="header__logo-image" src="{{ 'logo.jpg' | asset_url }}" alt="{{ logo_alt }}" width="1080" height="607">
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="{{ 'general.main_navigation' | t }}">
      <ul class="header__menu">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a class="header__link{% if link.active %} header__link--active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <search-toggle>
        <a class="icon-button" href="{{ routes.search_url }}" aria-expanded="false">
          {% render 'icon', name: 'search', alt: '' %}
          <span class="visually-hidden">{{ 'general.search' | t }}</span>
        </a>
      </search-toggle>

      {%- if shop.customer_accounts_enabled -%}
        <div class="header__account">
          <a class="icon-button" href="{{ routes.account_url }}">
            {% render 'icon', name: 'account', alt: '' %}
            <span class="visually-hidden">{{ 'general.account' | t }}</span>
          </a>
          <div class="header__dropdown-wrap">
            <ul class="header__dropdown">
              <li><a href="{{ routes.account_login_url }}">{{ 'header.profile' | t }}</a></li>
              <li><a href="{{ routes.account_url }}">{{ 'header.orders' | t }}</a></li>
              <li><a href="{{ routes.account_logout_url }}">{{ 'header.logout' | t }}</a></li>
            </ul>
          </div>
        </div>
      {%- endif -%}

      <a class="icon-button icon-button--dark" href="{{ routes.cart_url }}">
        {% render 'icon', name: 'cart', alt: '' %}
        <span class="visually-hidden">{{ 'general.cart' | t }}</span>
        {% render 'badge', count: cart.item_count %}
      </a>

      <button class="icon-button header__menu-button" type="button" data-menu-open aria-expanded="false" aria-controls="mobile-menu">
        {% render 'icon', name: 'menu', alt: '' %}
        <span class="visually-hidden">{{ 'header.open_menu' | t }}</span>
      </button>
    </div>
  </div>

  <mobile-menu>
    <div class="mobile-menu" id="mobile-menu" data-menu-panel>
      <div class="mobile-menu__top">
        <p class="mobile-menu__brand">{{ brand }}</p>
        <button class="mobile-menu__back" type="button" data-menu-close>
          <img class="icon mobile-menu__back-icon" src="{{ 'icon-back.png' | asset_url }}" alt="" width="16" height="16" loading="lazy">
          <span>{{ 'header.back' | t }}</span>
        </button>
      </div>
      <ul class="mobile-menu__links">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a class="mobile-menu__link{% if link.active %} mobile-menu__link--active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </mobile-menu>
</header>

{% stylesheet %}
  .header { width: 100%; padding-block: 1.25rem; font-weight: 500; }
  .header__bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1rem; border: 1px solid var(--color-header-border); border-radius: var(--radius-nav);
    background: linear-gradient(135deg, var(--color-header-start), var(--color-header-end));
    box-shadow: var(--shadow-nav);
  }
  .header__logo { display: flex; align-items: center; gap: 0.75rem; }
  .header__logo-image { width: calc(var(--logo-width) * 0.8); height: auto; border-radius: var(--radius-xl); }
  .header__nav { display: none; }
  .header__menu {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem;
    border: 1px solid #eed3c2; border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.7); font-size: 0.875rem; line-height: 1.25rem; color: #5f493d;
  }
  .header__link {
    display: block; padding: 0.5rem 1rem; border-radius: var(--radius-pill);
    font-size: 12px; text-transform: uppercase; letter-spacing: 0.22em; transition: background-color var(--duration-base), color var(--duration-base);
  }
  .header__link:hover { background: #f5e4d7; color: #2e1d14; }
  .header__link--active, .header__link--active:hover { background: #2e1d14; color: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 0.05); }
  .header__actions { display: flex; align-items: center; gap: 0.75rem; }
  .header__account { position: relative; }
  .header__dropdown-wrap { position: absolute; right: 0; z-index: 20; display: none; padding-top: 1rem; }
  .header__account:hover .header__dropdown-wrap, .header__account:focus-within .header__dropdown-wrap { display: block; }
  .header__dropdown {
    display: flex; flex-direction: column; gap: 0.5rem; width: 11rem; padding: 1rem 1.25rem;
    border: 1px solid #ecd4c3; border-radius: var(--radius-2xl);
    background: linear-gradient(180deg, #fffaf5, #f8e3d3);
    font-size: 0.875rem; line-height: 1.25rem; color: #6c5548; box-shadow: var(--shadow-dropdown);
  }
  .header__dropdown a { transition: color var(--duration-base); }
  .header__dropdown a:hover { color: #2e1d14; }
  .header__menu-button { display: flex; }

  .mobile-menu {
    position: fixed; top: 0; right: 0; bottom: 0; z-index: 30; width: 0; overflow: hidden; visibility: hidden;
    background: linear-gradient(180deg, rgb(255 249 244 / 0.98), rgb(246 220 200 / 0.98));
    color: #5d4639; transition: width var(--duration-base), visibility 0s linear var(--duration-base);
  }
  .mobile-menu.is-open { width: 100%; visibility: visible; transition-delay: 0s; }
  .mobile-menu__top { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-bottom: 1px solid #e8cab4; }
  .mobile-menu__brand { margin-top: 0.25rem; font-size: 1.125rem; line-height: 1.75rem; font-weight: 600; color: #2e1d14; }
  .mobile-menu__back {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 1rem;
    border: 1px solid #e8cab4; border-radius: var(--radius-pill); background: rgb(255 255 255 / 0.7);
  }
  .mobile-menu__back-icon { transform: rotate(180deg); height: 1rem; width: auto; }
  .mobile-menu__links { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.5rem; }
  .mobile-menu__link {
    display: block; padding: 1rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-2xl);
    background: rgb(255 255 255 / 0.7); font-size: 0.875rem; line-height: 1.25rem; text-transform: uppercase; letter-spacing: 0.25em; color: #5d4639;
  }
  .mobile-menu__link--active { border-color: transparent; background: #2e1d14; color: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 0.05); }

  @media (min-width: 640px) {
    .header__bar { padding-inline: 1.5rem; }
    .header__logo-image { width: var(--logo-width); }
    .header__nav { display: block; }
    .header__actions { gap: 1rem; }
    .header__menu-button { display: none; }
    .mobile-menu { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
