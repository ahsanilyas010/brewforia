<div class="search">
  <h1>{{ 'search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search">
    <label for="search-input">{{ 'search.label' | t }}</label>
    <input id="search-input" type="search" name="q" value="{{ search.terms | escape }}">
    <button type="submit">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 12 -%}
      <p>{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      <ul class="search__results">
        {%- for item in search.results -%}
          <li>
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}">{{ item.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "settings": []
}
{% endschema %}
