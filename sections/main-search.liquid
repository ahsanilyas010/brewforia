<section class="search">
  <div class="search__title">
    {% render 'section-title', text1: section.settings.title_first, text2: section.settings.title_second, tag: 'h1' %}
  </div>

  <form class="search__form" action="{{ routes.search_url }}" method="get" role="search">
    <input type="hidden" name="type" value="product">
    <label class="visually-hidden" for="search-input-{{ section.id }}">{{ 'search.label' | t }}</label>
    <input id="search-input-{{ section.id }}" class="input search__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}">
    <button class="button button--primary search__button" type="submit">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="search__count">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
      <ul class="search__grid">
        {%- for item in search.results -%}
          <li>
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}">{{ item.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% stylesheet %}
  .search { padding-top: 2rem; border-top: 1px solid #e0c7b6; margin-bottom: 5rem; }
  .search__title { font-size: 1.5rem; line-height: 2rem; }
  .search__form { display: flex; flex-direction: column; gap: 0.75rem; max-width: 40rem; margin-block: 1.5rem; }
  .search__button { padding: 1rem 2rem; }
  .search__count { margin-bottom: 1.5rem; color: var(--color-text); }
  .search__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1rem; }
  @media (min-width: 640px) { .search__form { flex-direction: row; } .search__input { flex: 1; width: auto; } }
  @media (min-width: 768px) { .search__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .search__grid { grid-template-columns: repeat(4, 1fr); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_search.name",
  "settings": [
    { "type": "text", "id": "title_first", "label": "t:sections.main_search.settings.title_first.label", "default": "SEARCH" },
    { "type": "text", "id": "title_second", "label": "t:sections.main_search.settings.title_second.label", "default": "RESULTS" }
  ]
}
{% endschema %}
