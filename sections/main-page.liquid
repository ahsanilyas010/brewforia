<section class="page">
  <div class="page__title">
    {% render 'section-title', text1: '', text2: page.title, tag: 'h1' %}
  </div>
  <div class="page__content">{{ page.content }}</div>
</section>

{% stylesheet %}
  .page { padding-top: 2rem; border-top: 1px solid #e0c7b6; margin-bottom: 5rem; }
  .page__title { font-size: 1.5rem; line-height: 2rem; }
  .page__content { max-width: 48rem; margin-top: 1.5rem; line-height: 1.75rem; color: var(--color-text); }
  .page__content p + p { margin-top: 1rem; }
  .page__content a { text-decoration: underline; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_page.name",
  "settings": []
}
{% endschema %}
