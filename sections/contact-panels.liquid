<section class="contact">
  <div class="contact__title">
    {% render 'section-title', text1: section.settings.title_first, text2: section.settings.title_second, tag: 'h1' %}
  </div>

  <div class="contact__layout">
    <div class="contact__panel">
      <ul class="contact__tiles">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tile' -%}
            <li class="contact__tile-item" {{ block.shopify_attributes }}>
              {%- if block.settings.url != blank -%}
                <a class="contact__tile contact__tile--link" href="{{ block.settings.url }}">
                  <p class="contact__label">{{ block.settings.label }}</p>
                  <p class="contact__value">{{ block.settings.value }}</p>
                  <p class="contact__description">{{ block.settings.description }}</p>
                  {%- if block.settings.cta != blank -%}<p class="contact__cta">{{ block.settings.cta }}</p>{%- endif -%}
                </a>
              {%- else -%}
                <div class="contact__tile">
                  <p class="contact__label">{{ block.settings.label }}</p>
                  <p class="contact__value">{{ block.settings.value }}</p>
                  <p class="contact__description">{{ block.settings.description }}</p>
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <ul class="contact__chips">
        {%- for block in section.blocks -%}
          {%- if block.type == 'chip' -%}
            <li class="contact__chip" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="contact__aside">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '500, 750, 1000', sizes: '(min-width: 1024px) 40vw, 90vw', alt: section.settings.image_alt, class: 'contact__image', loading: 'lazy' }}
      {%- else -%}
        <img class="contact__image" src="{{ 'contact.png' | asset_url }}" alt="{{ section.settings.image_alt }}" width="1000" height="667" loading="lazy">
      {%- endif -%}
      <div class="contact__aside-body">
        <p class="contact__aside-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="contact__aside-heading">{{ section.settings.heading }}</h2>
        <p class="contact__aside-text">{{ section.settings.text }}</p>
        <div class="contact__buttons">
          {%- if section.settings.call_url != blank -%}
            <a class="contact__call" href="{{ section.settings.call_url }}">{{ section.settings.call_label }}</a>
          {%- endif -%}
          {%- if section.settings.email_url != blank -%}
            <a class="button button--secondary" href="{{ section.settings.email_url }}">{{ section.settings.email_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .contact { padding-top: 2rem; border-top: 1px solid #e8c9b5; }
  .contact__title { text-align: center; font-size: 1.5rem; line-height: 2rem; }
  .contact__layout { display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-top: 2.5rem; }
  .contact__panel {
    overflow: hidden; border: 1px solid #edcdb7; border-radius: var(--radius-feature);
    background: linear-gradient(145deg, rgb(255 249 244 / 0.98), rgb(247 226 209 / 0.95)); box-shadow: var(--shadow-contact);
  }
  .contact__tiles { display: grid; grid-template-columns: 1fr; gap: 1px; background: #edcdb7; }
  .contact__tile-item { display: flex; }
  .contact__tile { display: block; flex: 1; padding: 1.75rem 1.5rem; transition: background-color var(--duration-base); }
  .contact__tile-item:nth-child(1) .contact__tile { background: rgb(255 255 255 / 0.85); }
  .contact__tile-item:nth-child(1) .contact__tile--link:hover { background: #fff; }
  .contact__tile-item:nth-child(2) .contact__tile { background: #fff6ef; }
  .contact__tile-item:nth-child(2) .contact__tile--link:hover { background: #fff9f5; }
  .contact__tile-item:nth-child(3) .contact__tile { background: #fff8f2; }
  .contact__tile-item:nth-child(4) .contact__tile { background: #fff3e8; }
  .contact__label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.28em; color: var(--color-eyebrow); }
  .contact__value { margin-top: 0.75rem; font-size: 1.125rem; line-height: 1.75rem; font-weight: 500; color: #3b2417; overflow-wrap: anywhere; }
  .contact__description { margin-top: 0.5rem; font-size: 0.875rem; line-height: 1.25rem; color: #735748; }
  .contact__cta { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.25rem; font-weight: 500; color: #6a3e23; transition: transform var(--duration-base); }
  .contact__tile--link:hover .contact__cta { transform: translateX(0.25rem); }
  .contact__chips {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; padding: 1.25rem 1.5rem;
    border-top: 1px solid #edcdb7; background: rgb(255 255 255 / 0.8); font-size: 0.75rem; line-height: 1rem;
  }
  .contact__chip { padding: 0.25rem 0.75rem; border: 1px solid #e2bfa8; border-radius: var(--radius-pill); background: #fff7f1; color: #6f4d3c; }
  .contact__aside {
    position: relative; overflow: hidden; padding: 1.5rem; border: 1px solid #efcfba; border-radius: var(--radius-feature);
    background: radial-gradient(circle at top, rgb(255 255 255 / 0.95), rgb(249 224 201 / 0.85) 55%, rgb(233 183 145 / 0.78) 100%);
    box-shadow: var(--shadow-contact-aside);
  }
  .contact__image { width: 100%; height: 13rem; border-radius: var(--radius-2xl); object-fit: cover; box-shadow: var(--shadow-contact-image); }
  .contact__aside-body { margin-top: 1.5rem; }
  .contact__aside-eyebrow { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.28em; color: #9a5a33; }
  .contact__aside-heading { margin-top: 0.75rem; font-size: 1.5rem; line-height: 1.25; font-weight: 600; color: #3a2418; }
  .contact__aside-text { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.75rem; color: #684d3f; }
  .contact__buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .contact__call {
    padding: 0.625rem 1.25rem; border-radius: var(--radius-pill); background: #2f1c13; color: #fff;
    font-size: 0.875rem; line-height: 1.25rem; font-weight: 500; transition: background-color var(--duration-base);
  }
  .contact__call:hover { background: #22140d; }
  @media (min-width: 640px) {
    .contact__tiles { grid-template-columns: repeat(2, 1fr); }
    .contact__chips { font-size: 0.875rem; line-height: 1.25rem; }
    .contact__aside { padding: 2rem; }
    .contact__image { height: 15rem; }
    .contact__aside-text { font-size: 1rem; }
  }
  @media (min-width: 1024px) { .contact__layout { grid-template-columns: 1.1fr 0.9fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact_panels.name",
  "settings": [
    { "type": "text", "id": "title_first", "label": "t:sections.contact_panels.settings.title_first.label", "default": "CONTACT" },
    { "type": "text", "id": "title_second", "label": "t:sections.contact_panels.settings.title_second.label", "default": "US" },
    { "type": "image_picker", "id": "image", "label": "t:sections.contact_panels.settings.image.label", "info": "t:sections.contact_panels.settings.image.info" },
    { "type": "text", "id": "image_alt", "label": "t:sections.contact_panels.settings.image_alt.label", "default": "Brewphoria customer support" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.contact_panels.settings.eyebrow.label", "default": "Quick Contact" },
    { "type": "text", "id": "heading", "label": "t:sections.contact_panels.settings.heading.label", "default": "Need help right away?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.contact_panels.settings.text.label",
      "default": "For fastest support, call us directly. For order details and collaboration requests, send us an email and we will get back to you promptly."
    },
    { "type": "text", "id": "call_label", "label": "t:sections.contact_panels.settings.call_label.label", "default": "Call Support" },
    { "type": "url", "id": "call_url", "label": "t:sections.contact_panels.settings.call_url.label", "default": "tel:+923308653077" },
    { "type": "text", "id": "email_label", "label": "t:sections.contact_panels.settings.email_label.label", "default": "Email Team" },
    { "type": "url", "id": "email_url", "label": "t:sections.contact_panels.settings.email_url.label", "default": "mailto:utanveer485@gmail.com" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:sections.contact_panels.blocks.tile.name",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.contact_panels.blocks.tile.settings.label.label", "default": "Phone" },
        { "type": "text", "id": "value", "label": "t:sections.contact_panels.blocks.tile.settings.value.label" },
        { "type": "text", "id": "description", "label": "t:sections.contact_panels.blocks.tile.settings.description.label" },
        { "type": "url", "id": "url", "label": "t:sections.contact_panels.blocks.tile.settings.url.label", "info": "t:sections.contact_panels.blocks.tile.settings.url.info" },
        { "type": "text", "id": "cta", "label": "t:sections.contact_panels.blocks.tile.settings.cta.label" }
      ]
    },
    {
      "type": "chip",
      "name": "t:sections.contact_panels.blocks.chip.name",
      "settings": [
        { "type": "text", "id": "text", "label": "t:sections.contact_panels.blocks.chip.settings.text.label", "default": "Order support" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.contact_panels.name" }]
}
{% endschema %}
