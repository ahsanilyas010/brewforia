<section class="password">
  <h1 class="password__title">{{ settings.brand_name | default: shop.name }}</h1>
  <p class="password__message">{{ 'password.message' | t }}</p>

  {%- form 'storefront_password', class: 'password__form' -%}
    {{ form.errors | default_errors }}
    <label class="visually-hidden" for="password-input">{{ 'password.label' | t }}</label>
    <input id="password-input" class="input" type="password" name="password" placeholder="{{ 'password.label' | t }}" required>
    <button class="button button--primary password__button" type="submit">{{ 'password.submit' | t }}</button>
  {%- endform -%}
</section>

{% stylesheet %}
  .password { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding: 6rem 1rem; text-align: center; }
  .password__title { font-size: 2.25rem; line-height: 2.5rem; font-weight: 600; color: var(--color-primary); }
  .password__message { color: var(--color-text); }
  .password__form { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; max-width: 24rem; }
  .password__button { padding: 1rem 2rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
