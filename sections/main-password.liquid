<div class="password">
  <h1>{{ shop.name }}</h1>
  <p>{{ 'password.message' | t }}</p>

  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <label for="password-input">{{ 'password.label' | t }}</label>
    <input id="password-input" type="password" name="password" required>
    <button type="submit">{{ 'password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
