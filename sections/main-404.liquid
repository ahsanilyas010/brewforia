<section class="not-found">
  <p class="not-found__code">404</p>
  <h1 class="not-found__title">{{ 'general.not_found_title' | t }}</h1>
  <a class="button button--primary not-found__link" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
</section>

{% stylesheet %}
  .not-found { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding-block: 6rem; text-align: center; }
  .not-found__code { font-size: 3rem; line-height: 1; font-weight: 700; color: var(--color-primary); }
  .not-found__title { font-size: 1.5rem; line-height: 2rem; color: var(--color-heading); }
  .not-found__link { margin-top: 1rem; padding: 0.75rem 2rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_404.name",
  "settings": []
}
{% endschema %}
