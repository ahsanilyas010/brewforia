{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glow-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.15;
    font-weight: {{ block.settings.font_weight }};
    text-align: {{ block.settings.alignment }};
    text-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }};
    animation: ai-glow-pulse-{{ ai_gen_id }} {{ block.settings.pulse_speed }}s ease-in-out infinite alternate;
  }

  @keyframes ai-glow-pulse-{{ ai_gen_id }} {
    from {
      text-shadow: 0 0 2px {{ block.settings.glow_color }};
    }
    to {
      text-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }}, 0 0 calc({{ block.settings.glow_size }}px * 1.5) {{ block.settings.glow_color }};
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-glow-heading-{{ ai_gen_id }} {
      animation: none;
      text-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-glow-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }
{% endstyle %}

<h2 class="ai-glow-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>

{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little moment of magic"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Text color",
      "default": "#3f2b21"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#d37b46"
    },
    {
      "type": "range",
      "id": "glow_size",
      "label": "Glow intensity",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "pulse_speed",
      "label": "Pulse speed",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "s",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Glowing heading"
    }
  ],
  "tag": null,
  "class": "glowing-heading-block"
}
{% endschema %}