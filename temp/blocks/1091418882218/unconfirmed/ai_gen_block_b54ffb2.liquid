{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-timeline-{{ ai_gen_id }}__heading {
    margin: 0 0 2rem;
    color: {{ block.settings.heading_color }};
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  .ai-timeline-{{ ai_gen_id }}__list {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-timeline-{{ ai_gen_id }}__list::before,
  .ai-timeline-{{ ai_gen_id }}__progress {
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.1rem;
    width: 2px;
    content: '';
  }

  .ai-timeline-{{ ai_gen_id }}__list::before {
    background: {{ block.settings.track_color }};
  }

  .ai-timeline-{{ ai_gen_id }}__progress {
    z-index: 1;
    height: var(--timeline-progress, 0%);
    max-height: calc(100% - 3rem);
    background: {{ block.settings.active_color }};
    transition: height 180ms ease-out;
  }

  .ai-timeline-{{ ai_gen_id }}__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1.25rem;
    padding: 1rem 0 2rem;
  }

  .ai-timeline-{{ ai_gen_id }}__marker {
    position: relative;
    z-index: 2;
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 2px solid {{ block.settings.track_color }};
    border-radius: 50%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-size: 0.8rem;
    font-weight: 700;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
  }

  .ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__marker {
    border-color: {{ block.settings.active_color }};
    background: {{ block.settings.active_color }};
    color: #ffffff;
  }

  .ai-timeline-{{ ai_gen_id }}__content {
    padding: 0.15rem 0 0.5rem;
    opacity: 0.62;
    transition: opacity 180ms ease;
  }

  .ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__content {
    opacity: 1;
  }

  .ai-timeline-{{ ai_gen_id }}__title {
    margin: 0 0 0.55rem;
    color: {{ block.settings.heading_color }};
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .ai-timeline-{{ ai_gen_id }}__description {
    line-height: 1.65;
  }

  .ai-timeline-{{ ai_gen_id }}__description p {
    margin: 0;
  }

  .ai-timeline-{{ ai_gen_id }}__item:last-child {
    padding-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-timeline-{{ ai_gen_id }}__progress,
    .ai-timeline-{{ ai_gen_id }}__marker,
    .ai-timeline-{{ ai_gen_id }}__content {
      transition: none;
    }
  }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" data-timeline-id="{{ ai_gen_id }}" style="--timeline-progress: 0%;" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-timeline-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  <ol class="ai-timeline-{{ ai_gen_id }}__list" aria-label="{{ block.settings.accessible_label | escape }}">
    <span class="ai-timeline-{{ ai_gen_id }}__progress" aria-hidden="true"></span>
    {% for i in (1..5) %}
      {% liquid
        assign title_key = 'step_' | append: i | append: '_title'
        assign description_key = 'step_' | append: i | append: '_description'
        assign step_title = block.settings[title_key]
        assign step_description = block.settings[description_key]
      %}
      {% if step_title != blank or step_description != blank %}
        <li class="ai-timeline-{{ ai_gen_id }}__item{% if forloop.first %} is-active{% endif %}">
          <span class="ai-timeline-{{ ai_gen_id }}__marker" aria-hidden="true">{{ forloop.index }}</span>
          <div class="ai-timeline-{{ ai_gen_id }}__content">
            {% if step_title != blank %}<h3 class="ai-timeline-{{ ai_gen_id }}__title">{{ step_title | escape }}</h3>{% endif %}
            {% if step_description != blank %}<div class="ai-timeline-{{ ai_gen_id }}__description">{{ step_description }}</div>{% endif %}
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ol>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'scroll-timeline-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ScrollTimeline extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('.ai-timeline-{{ ai_gen_id }}__item'));
        if (!this.items.length) return;
        this.onScroll = () => this.updateTimeline();
        window.addEventListener('scroll', this.onScroll, { passive: true });
        window.addEventListener('resize', this.onScroll, { passive: true });
        this.updateTimeline();
      }
      disconnectedCallback() {
        window.removeEventListener('scroll', this.onScroll);
        window.removeEventListener('resize', this.onScroll);
      }
      updateTimeline() {
        const line = this.querySelector('.ai-timeline-{{ ai_gen_id }}__list');
        if (!line) return;
        const rect = line.getBoundingClientRect();
        const threshold = window.innerHeight * 0.55;
        let activeIndex = 0;
        this.items.forEach((item, index) => {
          if (item.getBoundingClientRect().top <= threshold) activeIndex = index;
        });
        this.items.forEach((item, index) => {
          item.classList.toggle('is-active', index <= activeIndex);
        });
        const usableHeight = Math.max(0, rect.height - 48);
        const activeItem = this.items[activeIndex];
        const marker = activeItem.querySelector('.ai-timeline-{{ ai_gen_id }}__marker');
        const markerRect = marker.getBoundingClientRect();
        const progress = Math.min(100, Math.max(0, ((markerRect.top + markerRect.height / 2 - rect.top - 24) / usableHeight) * 100));
        this.style.setProperty('--timeline-progress', progress + '%');
      }
    }
    customElements.define(tagName, ScrollTimeline);
  })();
</script>

{% schema %}
{
  "name": "Scroll timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" },
    { "type": "text", "id": "accessible_label", "label": "Timeline label", "default": "Timeline steps" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#3f2b21" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#6b5648" },
    { "type": "color", "id": "active_color", "label": "Active step", "default": "#2f1d14" },
    { "type": "color", "id": "track_color", "label": "Timeline track", "default": "#ead0bf" },
    { "type": "header", "content": "Timeline steps" },
    { "type": "text", "id": "step_1_title", "label": "Step 1 title", "default": "The beginning" },
    { "type": "richtext", "id": "step_1_description", "label": "Step 1 description", "default": "<p>Share the first chapter of your story.</p>" },
    { "type": "text", "id": "step_2_title", "label": "Step 2 title", "default": "A new idea" },
    { "type": "richtext", "id": "step_2_description", "label": "Step 2 description", "default": "<p>Describe the idea that helped you grow.</p>" },
    { "type": "text", "id": "step_3_title", "label": "Step 3 title", "default": "Growing together" },
    { "type": "richtext", "id": "step_3_description", "label": "Step 3 description", "default": "<p>Highlight a meaningful moment along the way.</p>" },
    { "type": "text", "id": "step_4_title", "label": "Step 4 title", "default": "A milestone" },
    { "type": "richtext", "id": "step_4_description", "label": "Step 4 description", "default": "<p>Celebrate a milestone with your community.</p>" },
    { "type": "text", "id": "step_5_title", "label": "Step 5 title", "default": "What's next" },
    { "type": "richtext", "id": "step_5_description", "label": "Step 5 description", "default": "<p>Tell visitors where your journey is headed.</p>" }
  ],
  "presets": [{ "name": "Scroll timeline" }],
  "tag": null,
  "class": "scroll-timeline-block"
}
{% endschema %}