{% doc %}
  Renders charset, viewport, title, canonical, description and Open Graph tags.
  Used by both layouts.

  @example
  {% render 'meta-tags' %}
{% enddoc %}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign og_title = page_title | default: brand
  assign og_description = page_description | default: shop.description | default: brand
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
-%}

<title>
  {{- page_title -}}
  {%- if current_page != 1 %} &ndash; {{ 'general.page_number' | t: number: current_page }}{% endif -%}
  {%- unless page_title contains brand %} &ndash; {{ brand }}{% endunless -%}
</title>

<link rel="canonical" href="{{ canonical_url }}">

{%- if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif %}

<meta property="og:site_name" content="{{ brand }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image %}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
